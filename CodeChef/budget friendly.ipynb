    "# cook your dish here\n",
    "a=int(input())\n",
    "for x in range(a):\n",
    "    x,y=map(int,input().split())\n",
    "    totla_expense=y*30\n",
    "    if x >=totla_expense :\n",
    "        print(\"YES\")\n",
    "    else:\n",
    "        print(\"NO\")"
   ]
