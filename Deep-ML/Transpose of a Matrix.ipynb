    "import numpy as np\n",
    "def transpose_matrix(a: list[list[int|float]]) -> list[list[int|float]]:\n",
    "    mat=np.array(a)\n",
    "    return mat.T\n",
    "print(transpose_matrix(a=[[1, 2, 3], [4, 5, 6]]))"
   ]
