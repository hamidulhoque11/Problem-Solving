    "n=int(input())\n",
    "target=float(input())\n",
    "sum=float(0)\n",
    "for x in range(n):\n",
    "    num=float(input())\n",
    "    sum+=num\n",
    "avg=float(sum/n)\n",
    "if avg<=target:\n",
    "    print(\"PASS\")\n",
    "else:\n",
    "    print(\"RETRY\")\n",
    "\n"
   ]
