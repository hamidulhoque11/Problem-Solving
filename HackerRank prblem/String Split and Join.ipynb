    "''' \n",
    "https://www.hackerrank.com/challenges/python-string-split-and-join/problem?isFullScreen=true\n",
    "'''\n",
    "\n",
    "def split_and_join(line):\n",
    "    value=line.split()\n",
    "    return \"-\".join(value)\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    line = input()\n",
    "    result = split_and_join(line)\n",
    "    print(result)"
