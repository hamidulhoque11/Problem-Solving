   ],
   "source": [
    "import numpy as np\n",
    "nums1 = [1, 3]\n",
    "nums2 = [2]\n",
    "marge=nums1+nums2\n",
    "arr1=np.array(marge)\n",
    "arr1.sort()\n",
    "median=np.median(arr1)\n",
    "print(arr1)\n",
    "print(median)\n"
   ]
